{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "assets": "node scripts/sync-assets.mjs",
    "check:model": "node scripts/sync-assets.mjs --audit",
    "check:interactions": "node scripts/check-backpack-layout.mjs && node scripts/check-trash-physics.mjs",
    "predev": "npm run assets",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "npm run assets",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/rapier": "2.2.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
